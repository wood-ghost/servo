use vstd::prelude::*;
use vstd::std_specs::iter::{
    IteratorSpec,
    IteratorSpecImpl,
};
use crate::mime_classifier_specs::helper::{
    zip_seq,
    lemma_zip_seq_drop_first,
    lemma_zip_seq_right_empty,
};

verus! {

// broadcast use vstd::std_specs::iter::group_iter_axioms;

pub struct MyZip2<'a, 'b, A, B> {
    left: core::slice::Iter<'a, A>,
    right: core::slice::Iter<'b, B>,
}

pub trait Iterator<'a, A: 'a>: 
    core::iter::Iterator<Item = &'a A>
    + IteratorSpec
    + Sized {
    fn my_zip<'b, B>(self, other: core::slice::Iter<'b, B>) -> (result: MyZip2<'a, 'b, A, B>)
    requires
        <Self as IteratorSpec>::obeys_prophetic_iter_laws(&self),
        <core::slice::Iter<'b, B> as IteratorSpec>::obeys_prophetic_iter_laws(&other),
    ensures
        <MyZip2<'a, 'b, A, B> as IteratorSpec>::obeys_prophetic_iter_laws(&result),
        <MyZip2<'a, 'b, A, B> as IteratorSpec>::remaining(&result) =~= zip_seq(
            <Self as IteratorSpec>::remaining(&self),
            <core::slice::Iter<'b, B> as IteratorSpec>::remaining(&other),
        ),
    ;
}

impl<'a, A> Iterator<'a, A> for core::slice::Iter<'a, A> {
    fn my_zip<'b, B>(self, other: core::slice::Iter<'b, B>) -> MyZip2<'a, 'b, A, B> {
        MyZip2 {
            left: self,
            right: other,
        }
    }
}


// impl<'a, 'b, A, B> MyZip2<'a, 'b, A, B> {
//     #[verifier::type_invariant]
//     pub closed spec fn inv(self) -> bool {
//         &&& <core::slice::Iter<'a, A> as IteratorSpec>::obeys_prophetic_iter_laws(&self.left)
//         &&& <core::slice::Iter<'b, B> as IteratorSpec>::obeys_prophetic_iter_laws(&self.right)
//         // &&& <core::slice::Iter<'a, A> as IteratorSpec>::will_return_none(&self.left)
//         // &&& <core::slice::Iter<'b, B> as IteratorSpec>::will_return_none(&self.right)
//     }
// }

impl<'a, 'b, A, B> core::iter::Iterator for MyZip2<'a, 'b, A, B>{
    type Item = (&'a A, &'b B);

    fn next(&mut self) -> (result: Option<Self::Item>) {
        let ghost old_left = self.left;
        let ghost old_right = self.right;
        match self.left.next() {
            // left exhausted: left.remaining() is unchanged, so zip_seq is too
            None => {
                proof {
                    assert(self.right == old_right);
                }
                None
            }
            Some(left_item) => match self.right.next() {
                None => {
                    proof { lemma_zip_seq_right_empty(
                            <core::slice::Iter<'a, A> as IteratorSpec>::remaining(&old_left),
                            <core::slice::Iter<'b, B> as IteratorSpec>::remaining(&old_right)
                        ); 
                    }
                    None
                },
                Some(right_item) => {
                    proof { lemma_zip_seq_drop_first(
                            <core::slice::Iter<'a, A> as IteratorSpec>::remaining(&old_left),
                            <core::slice::Iter<'b, B> as IteratorSpec>::remaining(&old_right)
                        ); 
                }
                    Some((left_item, right_item))
                },
            }
        }
    }
}



// https://github.com/verus-lang/verus/blob/main/source/vstd/std_specs/iter.rs#L364
impl<'a, 'b, A, B> IteratorSpecImpl for MyZip2<'a, 'b, A, B> {
    closed spec fn obeys_prophetic_iter_laws(&self) -> bool {
        &&& <core::slice::Iter<'a, A> as IteratorSpec>::obeys_prophetic_iter_laws(&self.left)
        &&& <core::slice::Iter<'b, B> as IteratorSpec>::obeys_prophetic_iter_laws(&self.right)
        // &&& self.inv()
        // true
    }

    #[verifier::prophetic]
    closed spec fn remaining(&self) -> Seq<Self::Item> {
        zip_seq(
            <core::slice::Iter<'a, A> as IteratorSpec>::remaining(&self.left),
            <core::slice::Iter<'b, B> as IteratorSpec>::remaining(&self.right),
        )
    }

    #[verifier::prophetic]
    closed spec fn will_return_none(&self) -> bool {
        // <core::slice::Iter<'a, A> as IteratorSpec>::will_return_none(&self.left)
        // || <core::slice::Iter<'b, B> as IteratorSpec>::will_return_none(&self.right)
        true
    }

    #[verifier::prophetic]
    open spec fn initial_value_relation(&self, init: &Self) -> bool {
        // &&& <Self as IteratorSpec>::remaining(self) == <Self as IteratorSpec>::remaining(init)
        // &&& <core::slice::Iter<'a, A> as IteratorSpec>::initial_value_relation(&self.left, &init.left)
        // &&& <core::slice::Iter<'b, B> as IteratorSpec>::initial_value_relation(&self.right, &init.right)
        true
    }

    closed spec fn decrease(&self) -> Option<nat> {
        None
    }

    open spec fn peek(&self, _index: int) -> Option<Self::Item> {
        None
    }
}





} // verus!