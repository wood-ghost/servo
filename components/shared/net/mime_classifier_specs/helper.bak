use vstd::prelude::*;

verus! {
pub open spec fn zip_seq<A, B>(left: Seq<A>, right: Seq<B>) -> Seq<(A, B)> {
    let len = if left.len() <= right.len() {
        left.len()
    } else {
        right.len()
    };

    Seq::new(
        len,
        |i: int| (left[i], right[i]),
    )
}

pub proof fn lemma_zip_seq_drop_first<A, B>(left: Seq<A>, right: Seq<B>)
    requires
        left.len() > 0,
        right.len() > 0,
    ensures
        zip_seq(left, right).drop_first() =~= zip_seq(left.drop_first(), right.drop_first()),
{}

pub proof fn lemma_zip_seq_right_empty<A, B>(left: Seq<A>, right: Seq<B>)
    requires
        left.len() > 0,
        right.len() == 0,
    ensures
        zip_seq(left.drop_first(), right) =~= zip_seq(left, right),
{}

} // verus!